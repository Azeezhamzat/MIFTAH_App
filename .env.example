# Copy to .env and adjust for your environment.

# SQLite file database (swap for postgresql:// in production — see README).
DATABASE_URL="file:./dev.db"

# NextAuth
# Also doubles as the key-derivation secret for encrypting any learner-supplied
# Anthropic API key at rest (see src/lib/crypto.ts) — keep it stable in production,
# since rotating it invalidates previously stored keys.
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"
